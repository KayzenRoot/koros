# Local synthetic environment only. No production credentials belong here.
# The runner binds PostgreSQL and the app to 127.0.0.1 and refuses production,
# non-loopback hosts and Docker socket settings.
KOROS_LOCAL_DB_HOST=127.0.0.1
KOROS_LOCAL_APP_HOST=127.0.0.1
KOROS_LOCAL_DB_PORT=55432
KOROS_LOCAL_APP_PORT=3030
# Optional: absolute PostgreSQL 17 bin directory.
# KOROS_PG_BIN=/usr/lib/postgresql/17/bin
